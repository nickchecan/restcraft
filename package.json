{
	"name": "restcraft",
	"displayName": "RestCraft",
	"description": "Create, manage, and execute API requests from file-based definitions using a Postman-like interface inside Visual Studio Code.",
	"version": "1.12.4",
	"publisher": "nickchecan",
	"icon": "media/icon-gear-clean-transparent.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/nickchecan/restcraft.git"
	},
	"engines": {
		"vscode": "^1.118.0"
	},
	"categories": [
		"Testing",
		"Other"
	],
	"keywords": [
		"api",
		"http",
		"https",
		"rest",
		"request",
		"testing",
		"postman",
		"client",
		"webview",
		"environment"
	],
	"activationEvents": [
		"onCustomEditor:restcraft.requestEditor",
		"onCommand:restcraft.createRequestFile",
		"onUri",
		"onLanguage:restcraft-request",
		"workspaceContains:**/*.api.json"
	],
	"extensionDependencies": [
		"vscode.json-language-features"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "%capabilities.untrustedWorkspaces.description%"
		}
	},
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "restcraft.showNetworkHistory",
				"title": "RestCraft: Show Network History"
			},
			{
				"command": "restcraft.showNetworkLog",
				"title": "RestCraft: Show Network Log"
			},
			{
				"command": "restcraft.createRequestFile",
				"title": "RestCraft: Create Request File"
			},
			{
				"command": "restcraft.importBruno",
				"title": "RestCraft: Import from Bruno"
			}
		],
		"languages": [
			{
				"id": "restcraft-request",
				"aliases": [
					"RestCraft Request"
				],
				"extensions": [
					".api.json"
				],
				"configuration": "./syntaxes/restcraft-request.language-configuration.json",
				"icon": {
					"light": "./media/request-icon-light.svg",
					"dark": "./media/request-icon-dark.svg"
				}
			},
			{
				"id": "restcraft-network-log",
				"aliases": [
					"RestCraft Network Log"
				]
			}
		],
		"grammars": [
			{
				"language": "restcraft-request",
				"scopeName": "source.json.restcraft.request",
				"path": "./syntaxes/restcraft-request.tmLanguage.json"
			},
			{
				"language": "restcraft-network-log",
				"scopeName": "source.restcraft-network-log",
				"path": "./syntaxes/restcraft-network-log.tmLanguage.json"
			}
		],
		"jsonLanguageParticipants": [
			{
				"languageId": "restcraft-request"
			}
		],
		"colors": [
			{
				"id": "restcraft.method.get",
				"description": "Foreground color for GET request files in the Explorer and editor tabs.",
				"defaults": {
					"dark": "#3FB950",
					"light": "#1A7F37",
					"highContrast": "#3CFF8A",
					"highContrastLight": "#116329"
				}
			},
			{
				"id": "restcraft.method.post",
				"description": "Foreground color for POST request files in the Explorer and editor tabs.",
				"defaults": {
					"dark": "#E3B341",
					"light": "#9A6700",
					"highContrast": "#FFD700",
					"highContrastLight": "#7A4F00"
				}
			},
			{
				"id": "restcraft.method.put",
				"description": "Foreground color for PUT request files in the Explorer and editor tabs.",
				"defaults": {
					"dark": "#58A6FF",
					"light": "#0969DA",
					"highContrast": "#6CB6FF",
					"highContrastLight": "#044289"
				}
			},
			{
				"id": "restcraft.method.delete",
				"description": "Foreground color for DELETE request files in the Explorer and editor tabs.",
				"defaults": {
					"dark": "#F85149",
					"light": "#CF222E",
					"highContrast": "#FF8080",
					"highContrastLight": "#A40E26"
				}
			},
			{
				"id": "restcraft.method.query",
				"description": "Foreground color for QUERY request files in the Explorer and editor tabs.",
				"defaults": {
					"dark": "#39C5CF",
					"light": "#0E7C86",
					"highContrast": "#4EFFFF",
					"highContrastLight": "#0A5C64"
				}
			},
			{
				"id": "restcraft.method.patch",
				"description": "Foreground color for PATCH request files in the Explorer and editor tabs.",
				"defaults": {
					"dark": "#BC8CFF",
					"light": "#8250DF",
					"highContrast": "#E2B3FF",
					"highContrastLight": "#6639BA"
				}
			},
			{
				"id": "restcraft.method.head",
				"description": "Foreground color for HEAD request files in the Explorer and editor tabs.",
				"defaults": {
					"dark": "#F0883E",
					"light": "#BC4C00",
					"highContrast": "#FFB000",
					"highContrastLight": "#8A3800"
				}
			},
			{
				"id": "restcraft.method.options",
				"description": "Foreground color for OPTIONS request files in the Explorer and editor tabs.",
				"defaults": {
					"dark": "#C9D1D9",
					"light": "#57606A",
					"highContrast": "#FFFFFF",
					"highContrastLight": "#424A53"
				}
			}
		],
		"customEditors": [
			{
				"viewType": "restcraft.requestEditor",
				"displayName": "API Workbench",
				"selector": [
					{
						"filenamePattern": "*.api.json"
					}
				],
				"priority": "default"
			}
		],
		"configurationDefaults": {
			"[restcraft-request]": {
				"editor.quickSuggestions": {
					"strings": true
				},
				"editor.suggest.insertMode": "replace"
			}
		},
		"configuration": {
			"title": "RestCraft",
			"properties": {
				"restcraft.redactSensitiveContentInNetworkLog": {
					"type": "boolean",
					"default": true,
					"scope": "application",
					"description": "Redact sensitive content in both the network log and Network History panel. Disable to show full URLs, headers, and bodies, including credentials and access tokens, in both views. Changes apply to new requests; existing log output and history entries are unchanged."
				},
				"restcraft.requestTimeout": {
					"type": "number",
					"default": 30000,
					"minimum": 0,
					"description": "Maximum time in milliseconds to wait for an API request. Set to 0 to disable the timeout."
				},
				"restcraft.showMethodBadge": {
					"type": "boolean",
					"default": true,
					"description": "Show a two-letter HTTP method badge on .api.json files in the Explorer and editor tabs."
				},
				"restcraft.showMethodColor": {
					"type": "boolean",
					"default": true,
					"description": "Color .api.json file names and badges by HTTP method in the Explorer and editor tabs."
				},
				"restcraft.suppressInsecureCredentialWarning": {
					"type": "boolean",
					"default": false,
					"scope": "application",
					"description": "Do not warn before sending authentication credentials to remote servers over unencrypted HTTP."
				},
				"restcraft.showEnvironmentVariableValues": {
					"type": "boolean",
					"default": true,
					"scope": "application",
					"description": "Show resolved .env values in tooltips when hovering over {{VARIABLE}} references in request fields."
				},
				"restcraft.autoGenerateAuthorizationCodeState": {
					"type": "boolean",
					"default": false,
					"scope": "application",
					"description": "Automatically generate state for new authorization code flows when selecting Authorization Code in the Authorization tab, only if State is empty. Existing State values are preserved."
				},
				"restcraft.defaultTokenView": {
					"type": "string",
					"enum": [
						"raw",
						"decoded",
						"hidden"
					],
					"enumDescriptions": [
						"Show the access token.",
						"Show the decoded JWT header and payload.",
						"Hide the token output."
					],
					"default": "raw",
					"scope": "application",
					"description": "Token output view to select when opening the Authorization tab. Retrieving tokens preserves the selected view.",
					"enumItemLabels": [
						"Access Token",
						"Decoded Token",
						"Hidden"
					]
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.js --production",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"check-types": "tsc --noEmit",
		"lint": "eslint src test",
		"check": "npm run lint -- --max-warnings=0 && npm run format:check && npm run check-types",
		"test": "vscode-test",
		"release": "semantic-release",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "node .husky/install.ts",
		"test:unit": "npm run compile-tests && npm run compile && vscode-test --label unit",
		"test:integration": "npm run compile-tests && npm run compile && vscode-test --label integration"
	},
	"devDependencies": {
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@types/mocha": "^10.0.10",
		"@types/node": "26.x",
		"@types/vscode": "~1.118.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.1.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"husky": "9.1.7",
		"npm-run-all": "^4.1.5",
		"prettier": "3.9.10",
		"semantic-release": "^25.0.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
	},
	"overrides": {
		"mocha": {
			"diff": "^8.0.3",
			"serialize-javascript": "^7.1.2"
		}
	},
	"dependencies": {
		"yaml": "^2.9.1"
	}
}
